# Copy to .env.local for development, and add the same values in Vercel
# (Project -> Settings -> Environment Variables) before deploying.
#
# Server-only: these are read by the route handlers, never shipped to the
# browser. Without both values the app runs local-only and sync stays off.

# MongoDB Atlas connection string. Database user needs read/write on the db.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Optional. Defaults to "madhav_labels".
MONGODB_DB=madhav_labels

# Shared code entered once per device to allow writes. Keep it short enough to
# type on a phone, long enough not to be guessed (e.g. 10+ characters).
SYNC_CODE=change-me
